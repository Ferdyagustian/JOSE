# Azure Storage Account (ADLS Gen2)
# Diperlukan untuk upload ke cloud lakehouse. Kosongkan saat menjalankan pengujian lokal.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_storage_account;AccountKey=your_account_key;EndpointSuffix=core.windows.net

# YouTube Data API v3 Key
# Dapatkan dari Google Cloud Console (APIs & Services > Credentials).
YOUTUBE_API_KEY=AIzaSyYourMockOrRealApiKeyHere

# Runtime Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local Storage Paths (Digunakan jika berjalan tanpa Azure ADLS Gen2)
LOCAL_DATA_DIR=./data
BRONZE_CONTAINER_NAME=bronze
SILVER_CONTAINER_NAME=silver
GOLD_CONTAINER_NAME=gold
